# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=homeradar

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret (change in production!)
JWT_SECRET=dev-secret-key-change-in-production

# Data Source Credentials (Optional)

# BoIQ API
# BOIQ_API_KEY=your_boiq_api_key_here
# BOIQ_API_URL=https://api.boiq.dk

# Boligsiden scraper (npm run scrape:boligsiden) - pulls real active "for sale"
# listings from boligsiden.dk's public search pages. No API key needed.
# BOLIGSIDEN_MAX_PAGES=5
# BOLIGSIDEN_DELAY_MS=1500

# Instagram Graph API (official) - PAUSED. Business Discovery (looking up
# accounts outside our own Business Manager) requires Meta Advanced Access,
# which requires becoming a verified "Tech Provider" (business + access
# verification). Not pursuing this right now - see trigger.ts
# (ENABLE_INSTAGRAM_SCRAPING). Real listing data instead comes from the
# Boligsiden scraper above.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your_account_id
# INSTAGRAM_ACCESS_TOKEN=your_access_token

# Note: Facebook Marketplace has no public listings API and scraping it
# would violate Meta's Terms of Service, so it is not implemented. Use the
# Agent Portal (agents.ts) for real estate agents to submit their own
# "coming soon" listings instead.

# External Services
# GOOGLE_MAPS_API_KEY=your_google_maps_key
# REDIS_URL=redis://localhost:6379
