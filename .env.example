# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=homeradar

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret (change in production!)
JWT_SECRET=dev-secret-key-change-in-production

# Data Source Credentials (Optional)

# BoIQ API
# BOIQ_API_KEY=your_boiq_api_key_here
# BOIQ_API_URL=https://api.boiq.dk

# Instagram Graph API (official) - required for Instagram hashtag matching.
# Set up a Meta Developer App + Instagram Business Account to obtain these:
# https://developers.facebook.com/docs/instagram-api/guides/hashtag-search
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your_account_id
# INSTAGRAM_ACCESS_TOKEN=your_access_token

# Note: Facebook Marketplace has no public listings API and scraping it
# would violate Meta's Terms of Service, so it is not implemented. Use the
# Agent Portal (agents.ts) for real estate agents to submit their own
# "coming soon" listings instead.

# External Services
# GOOGLE_MAPS_API_KEY=your_google_maps_key
# REDIS_URL=redis://localhost:6379
